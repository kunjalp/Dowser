# Copy to app/.env.local (never commit it).
# Same deployment as the root .env.local's CONVEX_URL, but with the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Optional: swap the satellite basemap (e.g. a sponsor's or MapTiler's raster tiles). Needs {z}/{x}/{y}.
# NEXT_PUBLIC_BASEMAP_URL=
# NEXT_PUBLIC_BASEMAP_ATTRIBUTION=
