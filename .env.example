# Copy to .env.local (never commit). `npx convex dev` writes CONVEX_DEPLOYMENT / CONVEX_URL for you.
# Convex-side secrets are NOT read from this file; set them on the deployment:
#   npx convex env set INGEST_TOKEN "$(openssl rand -hex 24)"
#   npx convex env set ANTHROPIC_API_KEY sk-ant-...        (Saturday: brief generator)
INGEST_TOKEN=paste-the-same-token-here-for-local-curl-tests
