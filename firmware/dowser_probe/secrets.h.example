// Copy this file to secrets.h (same folder) and fill it in. secrets.h is git-ignored: never commit it.
#pragma once

// Venue Wi-Fi. The ESP32 joins 2.4 GHz networks only: if the venue has separate 2.4 GHz and 5 GHz names, use the 2.4 GHz one.
#define WIFI_SSID "Venue network name"
#define WIFI_PASS "venue password"   // use "" for an open network

// Only for WPA2-Enterprise networks (a username and password login, common on campuses). Compiles, but untested on a real network.
// Uncomment all four lines and fill them in. WIFI_PASS is ignored when WIFI_USE_ENTERPRISE is defined.
// #define WIFI_USE_ENTERPRISE
// #define WIFI_EAP_IDENTITY "username"
// #define WIFI_EAP_USERNAME "username"
// #define WIFI_EAP_PASSWORD "password"

// A network that shows a sign-in web page (captive portal) blocks the board until a browser signs in.
// The OLED then shows "login page? HTTP 302". Ask the organizers to allow the board's MAC address (printed in the serial log).

// Your team's Convex deployment (the .convex.site address) and its ingest token.
#define INGEST_URL "https://healthy-gull-811.convex.site/ingest/reading"
#define INGEST_TOKEN "ask the teammate who set INGEST_TOKEN in Convex"
#define DEVICE_ID "esp32-1"
